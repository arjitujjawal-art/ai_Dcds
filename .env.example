# ─── QueryMind 2.0 Environment Configuration ────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Flask Application & WSGI Server
SECRET_KEY=change-me-to-a-secure-random-secret-key
FLASK_ENV=production
FLASK_DEBUG=false
PORT=5000

# Optional: Supabase Cloud PostgreSQL Sync (Works out-of-the-box with local SQLite if blank)
SUPABASE_URL=
SUPABASE_KEY=

# Legacy optional database connectors (Optional, SQLite is primary default)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=querymind_db

MONGO_URI=mongodb://localhost:27017/
MONGO_DB=querymind_logs

